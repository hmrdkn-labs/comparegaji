---
import "../styles/global.css";

const {
    title = "CompareGaji",
    description = "Explore Indonesia's salary benchmarks across seniority levels and compare them against key global markets.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="description" content={description} />
    </head>
    <body>
        <div class="layout-shell">
            <slot />
        </div>
    </body>
</html>

<style is:global>
    :root {
        --color-surface: #ffffff;
        --color-text: #111111;
        --color-subtle-text: #4a4a4a;
        --color-border: rgba(17, 17, 17, 0.08);
        --color-accent-green: #0f9d58;
        --color-accent-yellow: #f4b400;
        --color-accent-blue: #4285f4;
        --color-muted-blue: #c7ddff;
        --shadow-soft: 0 16px 30px rgba(32, 62, 113, 0.08);
        --font-sans:
            "Inter", "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont,
            "Helvetica Neue", Arial, sans-serif;
    }

    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        min-height: 100%;
        background: var(--color-surface);
        color: var(--color-text);
        font-family: var(--font-sans);
        -webkit-font-smoothing: antialiased;
    }

    body {
        font-size: 16px;
        line-height: 1.6;
        display: flex;
        flex-direction: column;
    }

    .layout-shell {
        flex: 1;
        width: 100%;
    }

    main {
        display: block;
    }

    h1,
    h2,
    h3 {
        color: var(--color-text);
        margin: 0 0 0.5rem;
        font-weight: 600;
        line-height: 1.2;
    }

    p {
        margin: 0 0 1.25rem;
        color: var(--color-subtle-text);
    }

    a {
        color: var(--color-accent-blue);
        text-decoration: none;
    }

    a:hover,
    a:focus {
        text-decoration: underline;
    }

    button,
    input,
    select {
        font-family: inherit;
    }

    .calc-form {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .calc-form input,
    .calc-form select {
        min-height: 44px;
        width: 100%;
        padding: 0.5rem 0.75rem;
        font-size: 1rem;
        border: 1px solid rgba(17, 17, 17, 0.2);
        border-radius: 12px;
        background: var(--color-surface);
        color: var(--color-text);
    }

    .calc-form input[aria-invalid="true"] {
        border-color: #c62828;
    }

    .calc-error {
        color: #c62828;
        margin-bottom: 0.5rem;
    }

    .calc-parsed,
    .calc-note {
        font-size: 0.9rem;
        margin-bottom: 0.75rem;
    }

    .source-label {
        display: block;
        margin-top: 0.25rem;
        font-size: 0.75rem;
        line-height: 1.3;
        opacity: 0.75;
        font-weight: 400;
    }

    .sourced-table {
        min-width: 520px;
    }

    .sourced-table caption {
        caption-side: top;
        text-align: left;
        font-size: 0.8rem;
        opacity: 0.8;
        padding: 0 0 0.75rem;
    }

    .sourced-table th,
    .sourced-table td {
        padding: 0.6rem 0.75rem;
        white-space: normal;
        vertical-align: top;
    }

    .sourced-table td:first-child {
        white-space: nowrap;
    }

    .sourced-table .source-label {
        margin-top: 0.15rem;
    }

    .site-footer {
        margin-top: 2rem;
        font-size: 0.8rem;
        opacity: 0.8;
    }

    @media (max-width: 720px) {
        body {
            font-size: 15px;
        }
    }
</style>
